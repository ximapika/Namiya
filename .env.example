APP_ENV=development
SECRET_KEY=
PHONE_ENCRYPTION_KEY=
EMAIL_LOOKUP_KEY=
# Production requires a stable, owner-readable 0600 RSA3072+ private key file.
PASSWORD_TRANSPORT_PRIVATE_KEY_FILE=
DATABASE_URL=sqlite:///instance/worryshop.db
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
SESSION_COOKIE_SECURE=false
ENABLE_HSTS=false
RATELIMIT_STORAGE_URI=memory://
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
WEB_CONCURRENCY=4
GUNICORN_THREADS=4
TRUST_PROXY=false
USER_REQUEST_RATE_LIMIT=60 per minute
IP_REQUEST_RATE_LIMIT=120 per minute
DAILY_MESSAGE_LIMIT=5
DAILY_MESSAGE_TIMEZONE=Asia/Shanghai
PAGE_SIZE=20
EMAIL_CODE_TTL_SECONDS=600
EMAIL_RESEND_SECONDS=60
EMAIL_HOURLY_LIMIT=5
EMAIL_SEND_RATE_LIMIT=3 per minute
CHALLENGE_RATE_LIMIT=20 per minute
# Use your mail provider's SMTP settings. Keep passwords/authorization codes secret.
MAIL_HOST=
MAIL_PORT=465
MAIL_USE_SSL=true
MAIL_USE_TLS=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
